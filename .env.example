# Required in Vercel Production, Preview, and Development environments.
OPENAI_API_KEY=
SESSION_SECRET=replace-with-at-least-32-random-characters
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The current Vercel Marketplace integration may provide these names instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Production origin. Add comma-separated preview origins only when needed.
APP_ALLOWED_ORIGINS=https://plant-speaks.vercel.app

# Optional. Leave empty for public access after adult consent.
APP_ACCESS_CODE=

# Server-enforced daily limits per anonymous signed session.
DAILY_CHAT_LIMIT=30
DAILY_PHOTO_ANALYSIS_LIMIT=12
DAILY_DRAFT_LIMIT=8
DAILY_TTS_LIMIT=30

# Cost guardrails. Photo=5, draft=3, TTS=2, chat=1 budget unit.
AI_BURST_LIMIT_PER_MINUTE=60
GLOBAL_DAILY_AI_BUDGET=600
IP_DAILY_AI_BUDGET=200
